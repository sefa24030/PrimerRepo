<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fia.eisi.poo.gestioncarreras.controller.ConsultarCarrerasController"
            style="-fx-background-color: #f0f2f5; -fx-padding: 20;">

    <top>
        <VBox spacing="15" style="-fx-padding: 0 0 15 0;">
            <Text text="Consulta de Carreras"
                  style="-fx-font-size: 22; -fx-font-weight: bold; -fx-fill: #1f2937;"/>

            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <Label text="Buscar:" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>

                <TextField fx:id="buscarField"
                           promptText="Código o nombre de carrera"
                           prefWidth="300"
                           onAction="#filtrar"
                           style="-fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>

                <Button text="🔍 Filtrar" onAction="#filtrar"
                        style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>

                <Button text="Limpiar" onAction="#limpiarFiltro"
                        style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-padding: 8 18; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- ✅ NUEVO BOTÓN -->
                <Button text="+ Nueva carrera" onAction="#nuevaCarrera"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

            <TableView fx:id="tablaCarreras" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="220"/>
                    <TableColumn fx:id="colFacultad" text="Facultad" prefWidth="250"/>
                </columns>
                <placeholder>
                    <Label text="No hay carreras registradas"
                           style="-fx-text-fill: #9ca3af; -fx-font-style: italic;"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
            <Label fx:id="lblInfo" text="Doble clic en una carrera para editar o eliminar"
                   style="-fx-text-fill: #6b7280; -fx-font-style: italic;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Salir" onAction="#salir"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-border-radius: 6; -fx-background-radius: 6;"/>
        </HBox>
    </bottom>
</BorderPane>